# ====================================================================
# INDIAN EQUITY PAPER TRADING ENGINE — ENVIRONMENT CONFIGURATION
# ====================================================================
# NOTE: THIS SYSTEM IS CONFIGURED FOR PAPER / SHADOW TRADING ONLY.
# REAL BROKER ORDER PLACEMENT IS ARCHITECTURALLY DISABLED.
# ====================================================================

# Starting Capital for Live Paper Portfolio (Default: ₹10,00,000)
STARTING_CAPITAL=1000000.0

# Execution Simulation Slippage (in basis points, 25 bps = 0.25% per side)
SLIPPAGE_BPS_ENTRY=25.0
SLIPPAGE_BPS_EXIT=25.0

# Web Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Free Telegram Bot Alerts (Optional - Leave empty to use Console alerts)
# 1. Create a bot via @BotFather on Telegram to get your token
# 2. Get your Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook Alerts (Optional)
DISCORD_WEBHOOK_URL=

# Market Data Source (Optional override: NSE_BHAVCOPY or YAHOO_FINANCE)
MARKET_DATA_SOURCE=YAHOO_FINANCE
